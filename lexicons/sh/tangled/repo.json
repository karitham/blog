{
  "lexicon": 1,
  "id": "sh.tangled.repo",
  "description": "A Tangled repository record",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["name", "repoDid", "createdAt"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "repoDid": { "type": "string", "format": "did" },
          "createdAt": { "type": "string", "format": "datetime" },
          "topics": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
